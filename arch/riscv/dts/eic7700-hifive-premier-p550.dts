/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "eic7700.dtsi"

/ {
	compatible = "sifive,hifive-premier-p550", "eswin,eic7700";
	model = "SiFive HiFive Premier P550";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	vddio18: regulator-vddio18 {
		compatible = "regulator-fixed";
		regulator-name = "vddio18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

&gmac0 {
	phy-handle = <&gmac0_phy>;
	phy-mode = "rgmii-id";
	rx-internal-delay-ps = <20>;
	tx-internal-delay-ps = <100>;
	status = "okay";
};

&gmac0_mdio {
	gmac0_phy: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
		reset-gpios = <&portd 10 GPIO_ACTIVE_LOW>;
	};
};

&gmac1 {
	phy-handle = <&gmac1_phy>;
	phy-mode = "rgmii-rxid";
	rx-internal-delay-ps = <200>;
	tx-internal-delay-ps = <200>;
	status = "okay";
};

&gmac1_mdio {
	gmac1_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		reset-gpios = <&portd 15 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	rgmii0-supply = <&vddio18>;
	rgmii1-supply = <&vddio18>;
};

&uart0 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&xtal24m {
	clock-frequency = <24000000>;
};
